// Dev Container 配置
// 分工:宿主机跑 docker compose(中间件)+ 编辑代码,容器内编译、测试、运行服务。
// 中间件通过 host.docker.internal 访问(Docker Desktop 自动映射),config.json 已改成它。
{
  "name": "trade-reconcile-system (Ubuntu 22.04 / C++17 / Drogon)",

  "image": "ubuntu:22.04",

  // 以 root 运行:基础镜像不含 sudo,非 root 装不了包;
  // build/ 是 named volume,root 可绕开权限问题。
  "remoteUser": "root",

  "workspaceFolder": "/workspaces/trade-reconcile-system",

  "mounts": [
    // build/ 必须用 named volume。Windows 文件系统的小文件 IO 太慢,
    // bind mount 下增量编译会慢到不可用(差 5~10 倍)。
    "source=trade-reconcile-build,target=${containerWorkspaceFolder}/build,type=volume",

    // Docker socket:让 vscode-docker 扩展在容器内能看到镜像与容器。
    // 挂 socket 等于把宿主机 Docker 控制权交给容器,本地开发可以,
    // 别把这份配置带到共享环境。
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],

  // 若扩展版本较旧、${containerWorkspaceFolder} 不展开,把上面的 target
  // 换成写死的 /workspaces/trade-reconcile-system/build 即可。

  "containerEnv": {
    // 容器默认 UTC,与国内渠道账单日期对不上,对账会错位一天
    "TZ": "Asia/Shanghai",
    // 中文输出需要 UTF-8 环境
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8",
    "CMAKE_EXPORT_COMPILE_COMMANDS": "1"
  },

  // 依赖安装。补的包都是编译/运行必需:
  //   ninja-build   CMakePresets 用 Ninja 生成器
  //   libspdlog-dev 日志库;libgtest-dev 单测
  //   ca-certificates/gnupg 拉 packagecloud 源需要
  //   libpq-dev     Drogon 官方包可能带 PG 支持,缺了链接期报 undefined reference
  // Drogon 优先走 packagecloud 的 deb;源挂了自动退回源码编译(约 10~20 分钟)。
  // 源码编译注意:编译器 ABI 要一致(_GLIBCXX_USE_CXX11_ABI),否则一堆
  // std::string 的 undefined reference,真因是 ABI 不匹配而不是缺库。
  // 另补 mariadb-client:压测脚本要用;libmariadb-dev 与 libmysqlclient-dev
  // 冲突,只装前者,并补 /usr/include/mysql 软链(mysqlclient.pc 声明了它)。
  "postCreateCommand": "bash -c 'set -e; apt-get update && apt-get install -y --no-install-recommends build-essential cmake ninja-build git curl ca-certificates gnupg gdb pkg-config libssl-dev zlib1g-dev uuid-dev libjsoncpp-dev libhiredis-dev librabbitmq-dev libc-ares-dev libbrotli-dev libspdlog-dev libgtest-dev libpq-dev libmariadb-dev mariadb-client && ln -sfn /usr/include/mariadb /usr/include/mysql && { (curl -fsSL https://packagecloud.io/install/repositories/drogonframework/drogon/script.deb.sh | bash && apt-get install -y --no-install-recommends drogon) || (echo \"[WARN] packagecloud 不可用, 改为源码编译 Drogon v1.9.13\"; cd /tmp; git clone --depth 1 --branch v1.9.13 https://github.com/drogonframework/drogon.git; cd drogon; git submodule update --init --recursive; mkdir -p build; cd build; cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local -DBUILD_EXAMPLES=OFF -DBUILD_CTL=OFF -DBUILD_TESTING=OFF -DBUILD_DOC=OFF -DBUILD_REDIS=ON -DBUILD_MYSQL=ON -DBUILD_SQLITE=OFF; make -j$(nproc); make install; ldconfig; cd /tmp; rm -rf drogon); }; ldconfig; rm -rf /var/lib/apt/lists/*'",

  // 端口转发。8080 是容器内跑起来的 trade_server;
  // 其余几个是兜底,中间件实际跑在宿主机 compose 里。
  "forwardPorts": [8080, 3306, 6379, 5672, 15672],

  "portsAttributes": {
    "8080": {
      "label": "trade_server (HTTP)",
      "onAutoForward": "notify"
    },
    "3306": {
      "label": "MySQL 8.0",
      "onAutoForward": "silent"
    },
    "6379": {
      "label": "Redis 7",
      "onAutoForward": "silent"
    },
    "5672": {
      "label": "RabbitMQ (AMQP)",
      "onAutoForward": "silent"
    },
    "15672": {
      "label": "RabbitMQ 管理台",
      "onAutoForward": "silent"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        // 与 .vscode/settings.json 保持一致,防止容器重建后 IntelliSense 走默认值
        "C_Cpp.default.cppStandard": "c++17",
        "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.eol": "\n"
      }
    }
  },

  "remoteEnv": {
    "DEV_CONTAINER": "1"
  }
}
